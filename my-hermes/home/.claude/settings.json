{
  "cleanupPeriodDays": 3650,
  "permissions": {
    "allow": [
      "Read(./memory/**)",
      "Edit(./memory/**)",
      "Write(./memory/**)",
      "Read(./.claude/skills/**)",
      "Edit(./.claude/skills/**)",
      "Write(./.claude/skills/**)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/nudge.py\""
          }
        ]
      }
    ]
  }
}
